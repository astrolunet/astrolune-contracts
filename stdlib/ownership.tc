// Ownership - a minimal ownership pattern for Astrolune contracts.
//
// Compile:
//     trocto contracts/stdlib/ownership.tc -o ownership.bin
//     trocto contracts/stdlib/ownership.tc --emit-regol
//
// Provides owner state, transfer_ownership, and an only_owner modifier
// pattern for access-controlled functions.

contract Ownership {
    state {
        owner: address,
    }

    event OwnershipTransferred {
        old_owner: address,
        new_owner: address,
    }

    // Constructor: sets the deployer as the initial owner.
    init() {
        self.owner = sender();
    }

    // Returns the current owner.
    pub fn is_owner(candidate: address) -> u64 {
        if (self.owner == candidate) {
            return 1;
        }
        return 0;
    }

    // Transfers ownership to a new address. Only callable by the current owner.
    pub fn transfer_ownership(new_owner: address) -> u64 {
        require(sender() == self.owner, 1);
        let old_owner = self.owner;
        self.owner = new_owner;
        emit OwnershipTransferred(old_owner, new_owner);
        return 1;
    }

    // Renounces ownership, leaving the contract without an owner.
}
