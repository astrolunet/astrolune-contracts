// ContentOffer - on-chain marketplace listing for Astrolune Share content.

contract ContentOffer {
    state {
        owner: address,
        offer_count: u64,
        offer_prices: map<u64,u64>,
        offer_sellers: map<u64,address>,
        offer_content: map<u64,u64>,
        offer_active: map<u64,u64>,
    }

    event OfferCreated {
        offer_id: u64,
        seller: address,
        content_id: u64,
        price: u64,
    }

    event OfferUpdated {
        offer_id: u64,
        new_price: u64,
    }

    event OfferAccepted {
        offer_id: u64,
        buyer: address,
        price: u64,
    }

    init() {
        self.owner = sender();
        self.offer_count = 0;
    }

    pub fn create_offer(content_id: u64, price: u64) -> u64 {
        require(content_id != 0, 100);
        require(price > 0, 100);
        let offer_id = self.offer_count + 1;
        self.offer_count = offer_id;
        offer_prices[offer_id] = price;
        offer_sellers[offer_id] = sender();
        offer_content[offer_id] = content_id;
        offer_active[offer_id] = 1;
        emit OfferCreated(offer_id, sender(), content_id, price);
        return offer_id;
    }

    pub fn update_offer(offer_id: u64, new_price: u64) {
        require(offer_id <= self.offer_count, 101);
        require(offer_sellers[offer_id] == sender(), 102);
        require(offer_active[offer_id] == 1, 103);
        require(new_price > 0, 104);
        offer_prices[offer_id] = new_price;
        emit OfferUpdated(offer_id, new_price);
    }

    pub fn accept_offer(offer_id: u64) {
        require(offer_id <= self.offer_count, 105);
        require(offer_active[offer_id] == 1, 106);
        require(sender() != offer_sellers[offer_id], 107);
        emit OfferAccepted(offer_id, sender(), offer_prices[offer_id]);
    }

    pub fn get_offer_price(offer_id: u64) -> u64 {
        require(offer_id <= self.offer_count, 108);
        return offer_prices[offer_id];
    }

    pub fn get_offer_content(offer_id: u64) -> u64 {
        require(offer_id <= self.offer_count, 110);
        return offer_content[offer_id];
    }

    pub fn is_offer_active(offer_id: u64) -> u64 {
        require(offer_id <= self.offer_count, 111);
        return offer_active[offer_id];
    }

    pub fn is_offer_seller(offer_id: u64, seller: address) -> u64 {
        require(offer_id <= self.offer_count, 109);
        if (offer_sellers[offer_id] == seller) {
            return 1;
        }
        return 0;
    }

    pub fn deactivate_offer(offer_id: u64) {
        require(offer_id <= self.offer_count, 112);
        require(offer_sellers[offer_id] == sender(), 113);
        require(offer_active[offer_id] == 1, 114);
        offer_active[offer_id] = 0;
    }
}
