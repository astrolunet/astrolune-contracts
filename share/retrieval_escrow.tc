// RetrievalEscrow - payment escrow for Astrolune Share retrieval.

contract RetrievalEscrow {
    state {
        owner: address,
        escrow_count: u64,
        escrow_amounts: map<u64,u64>,
        escrow_buyers: map<u64,address>,
        escrow_status: map<u64,u64>,
    }

    event EscrowCreated {
        escrow_id: u64,
        buyer: address,
        amount: u64,
    }

    event EscrowReleased {
        escrow_id: u64,
        amount: u64,
    }

    event EscrowRefunded {
        escrow_id: u64,
        amount: u64,
    }

    init() {
        self.owner = sender();
        self.escrow_count = 0;
    }

    pub fn create_escrow(amount: u64) -> u64 {
        require(amount > 0, 200);
        let escrow_id = self.escrow_count + 1;
        self.escrow_count = escrow_id;
        escrow_amounts[escrow_id] = amount;
        escrow_buyers[escrow_id] = sender();
        escrow_status[escrow_id] = 0;
        emit EscrowCreated(escrow_id, sender(), amount);
        return escrow_id;
    }

    pub fn release_escrow(escrow_id: u64, to: address) {
        require(escrow_id <= self.escrow_count, 201);
        require(escrow_status[escrow_id] == 0, 202);
        require(sender() == self.owner, 203);
        let amount = escrow_amounts[escrow_id];
        escrow_status[escrow_id] = 1;
        pay(to, amount);
        emit EscrowReleased(escrow_id, amount);
    }

    pub fn refund_escrow(escrow_id: u64) {
        require(escrow_id <= self.escrow_count, 204);
        require(escrow_status[escrow_id] == 0, 205);
        require(escrow_buyers[escrow_id] == sender(), 206);
        let amount = escrow_amounts[escrow_id];
        escrow_status[escrow_id] = 2;
        pay(sender(), amount);
        emit EscrowRefunded(escrow_id, amount);
    }

    pub fn get_escrow_amount(escrow_id: u64) -> u64 {
        require(escrow_id <= self.escrow_count, 207);
        return escrow_amounts[escrow_id];
    }

    pub fn get_escrow_status(escrow_id: u64) -> u64 {
        require(escrow_id <= self.escrow_count, 209);
        return escrow_status[escrow_id];
    }

    pub fn is_escrow_buyer(escrow_id: u64, buyer: address) -> u64 {
        require(escrow_id <= self.escrow_count, 208);
        if (escrow_buyers[escrow_id] == buyer) {
            return 1;
        }
        return 0;
    }
}
