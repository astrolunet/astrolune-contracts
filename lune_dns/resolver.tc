// LuneResolver - DNS record resolver for the .lune DNS system.
//
// Record keys are derived as `domain_hash * 8 + record_type`. This keeps one
// authoritative record per domain/type pair and avoids unbounded traversal.

contract LuneResolver {
    state {
        owner: address,
        record_count: u64,
        record_values: map<u64,u64>,
    }

    event RecordSet {
        domain_hash: u64,
        record_type: u64,
        value: u64,
    }

    event RecordDeleted {
        domain_hash: u64,
        record_type: u64,
    }

    init() {
        self.owner = sender();
        self.record_count = 0;
    }

    pub fn set_record(domain_hash: u64, record_type: u64, value: u64) -> u64 {
        require(record_type >= 1, 1);
        require(record_type <= 6, 1);
        let key = domain_hash * 8 + record_type;
        let old_value = record_values[key];
        if (old_value == 0) {
            self.record_count += 1;
        }
        record_values[key] = value;
        emit RecordSet(domain_hash, record_type, value);
        return key;
    }

    pub fn get_record(domain_hash: u64, record_type: u64) -> u64 {
        require(record_type >= 1, 1);
        require(record_type <= 6, 1);
        return record_values[domain_hash * 8 + record_type];
    }

    pub fn delete_record(domain_hash: u64, record_type: u64) {
        require(record_type >= 1, 1);
        require(record_type <= 6, 1);
        let key = domain_hash * 8 + record_type;
        require(record_values[key] != 0, 3);
        record_values[key] = 0;
        self.record_count -= 1;
        emit RecordDeleted(domain_hash, record_type);
    }

    pub fn has_record(domain_hash: u64, record_type: u64) -> u64 {
        require(record_type >= 1, 1);
        require(record_type <= 6, 1);
        if (record_values[domain_hash * 8 + record_type] != 0) {
            return 1;
        }
        return 0;
    }

    pub fn get_record_count() -> u64 {
        return self.record_count;
    }
}
